{
  "name": "o3measure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "NODE_ENV=production vite build --mode production",
    "preview": "vite preview",
    "preview:prod": "vite preview --mode production",
    "dev-host": "vite --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:utils": "node --experimental-vm-modules tests/run-tests.js utils",
    "test:components": "node --experimental-vm-modules tests/run-tests.js components",
    "test:state": "node --experimental-vm-modules tests/run-tests.js state",
    "test:webxr": "node --experimental-vm-modules tests/run-tests.js webxr",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-icons:convert": "node scripts/generate-icons.js --convert",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "postbuild": "echo 'Build complete! Deploy the dist/ folder to your hosting service.'"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "eslint": "^9.24.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.0.0",
    "jsdom": "^23.0.1",
    "terser": "^5.44.1",
    "vite": "^6.0.5",
    "vite-plugin-mkcert": "^1.17.6",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "aframe": "^1.7.0",
    "aframe-slice9-component": "^1.0.0",
    "express": "^4.21.2",
    "three": "^0.173.0",
    "webxr": "^0.0.0"
  }
}
