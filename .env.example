# O3Measure Environment Configuration
# Copy this file to .env for local development

# Application
VITE_APP_NAME=O3Measure
VITE_APP_VERSION=0.1.0

# Environment
NODE_ENV=development

# Analytics (Optional - add your analytics ID)
# VITE_ANALYTICS_ID=

# Error Tracking (Optional - add your Sentry DSN)
# VITE_SENTRY_DSN=

# API Endpoints (if needed in the future)
# VITE_API_URL=

# Feature Flags
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_ERROR_LOGGING=true
VITE_ENABLE_SERVICE_WORKER=true

# Meta Quest Optimization
VITE_TARGET_DEVICE=meta-quest
VITE_ENABLE_FOVEATION=true
VITE_FOVEATION_LEVEL=1
