  "screenshots": [
    {
      "src": "/screenshots/screenshot1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Start AR Session",
      "short_name": "Start AR",
      "description": "Launch directly into AR mode",
      "url": "/?mode=ar",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "serviceworker": {
    "src": "/sw.js",
    "scope": "/",
    "type": "module",
    "update_via_cache": "none"
  }
}
